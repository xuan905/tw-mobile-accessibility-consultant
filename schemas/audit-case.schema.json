{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xuan905/tw-mobile-accessibility-consultant/blob/main/schemas/audit-case.schema.json",
  "title": "Taiwan Mobile Accessibility Audit Case",
  "description": "核心案件資料模型：用於管理行動 App、行動網站或 Web App 的無障礙檢測範圍、環境、證據、逐項發現與回歸測試。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case", "evidence", "findings"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "case": {
      "$ref": "#/$defs/case"
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" },
      "uniqueItems": true
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string", "minLength": 1 },
        "source_repository": { "type": "string", "format": "uri" }
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "product", "version", "product_type", "scope", "standard"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
        "product": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "product_type": {
          "type": "string",
          "enum": ["android_app", "ios_app", "mobile_web", "web_app", "hybrid_app", "other"]
        },
        "platforms": {
          "type": "array",
          "items": { "enum": ["android", "ios", "mobile_web", "web"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "scope": { "type": "string", "minLength": 1 },
        "flows": {
          "type": "array",
          "items": { "$ref": "#/$defs/flow" },
          "minItems": 1
        },
        "test_environments": {
          "type": "array",
          "items": { "$ref": "#/$defs/environment" }
        },
        "standard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "revision", "source_url", "checklist_total"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 },
            "source_url": { "type": "string", "format": "uri" },
            "checklist_total": { "type": "integer", "const": 42 },
            "target_level": { "type": "string", "enum": ["AA", "custom"] }
          }
        },
        "test_accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["account_id", "purpose", "sensitive_data_removed"],
            "properties": {
              "account_id": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "sensitive_data_removed": { "type": "boolean", "const": true }
            }
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow_id", "name", "steps", "completion_criteria"],
      "properties": {
        "flow_id": { "type": "string", "pattern": "^FLOW-[0-9]{2,4}$" },
        "name": { "type": "string", "minLength": 1 },
        "priority": { "type": "string", "enum": ["critical", "high", "normal", "low"] },
        "steps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "completion_criteria": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "platform", "os_version", "assistive_technology"],
      "properties": {
        "environment_id": { "type": "string", "pattern": "^ENV-[0-9]{2,4}$" },
        "platform": { "enum": ["android", "ios", "mobile_web", "web"] },
        "device_model": { "type": "string" },
        "os_version": { "type": "string", "minLength": 1 },
        "app_version": { "type": "string" },
        "assistive_technology": { "enum": ["talkback", "voiceover", "keyboard", "browser_a11y", "none", "other"] },
        "settings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "type", "title", "source", "verification_level"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^E-[0-9]{3,6}$" },
        "type": { "enum": ["screenshot", "video", "audio", "source_code", "test_log", "manual_note", "external_document", "other"] },
        "title": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri" },
        "captured_at": { "type": "string", "format": "date-time" },
        "environment_id": { "type": "string", "pattern": "^ENV-[0-9]{2,4}$" },
        "verification_level": { "enum": ["observed", "reproducible", "inferred", "pending_review"] },
        "notes": { "type": "string" },
        "contains_sensitive_data": { "type": "boolean", "const": false }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "check_id", "status", "title", "evidence_ids", "next_action"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^F-[0-9]{3,6}$" },
        "check_id": { "type": "string", "pattern": "^AA-[0-9]{2}$" },
        "status": { "enum": ["pass", "fail", "not_applicable", "pending"] },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["blocker", "high", "medium", "low", "info"] },
        "affected_users": { "type": "array", "items": { "type": "string" } },
        "flow_ids": { "type": "array", "items": { "type": "string", "pattern": "^FLOW-[0-9]{2,4}$" } },
        "environment_ids": { "type": "array", "items": { "type": "string", "pattern": "^ENV-[0-9]{2,4}$" } },
        "evidence_ids": { "type": "array", "items": { "type": "string", "pattern": "^E-[0-9]{3,6}$" } },
        "observation": { "type": "string" },
        "expected_result": { "type": "string" },
        "remediation": { "type": "string" },
        "owner_role": { "enum": ["product", "design", "engineering", "qa", "content", "accessibility_specialist", "unknown"] },
        "external_issue": { "type": "string" },
        "next_action": { "type": "string", "minLength": 1 },
        "regression": { "$ref": "#/$defs/regression" }
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "expected_result", "status"],
      "properties": {
        "steps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "expected_result": { "type": "string", "minLength": 1 },
        "actual_result": { "type": "string" },
        "tested_version": { "type": "string" },
        "tested_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["pass", "fail", "pending"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "not_applicable": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "const": 42 },
        "overall_conclusion": { "enum": ["ready", "conditional", "not_ready", "incomplete"] }
      }
    }
  }
}
